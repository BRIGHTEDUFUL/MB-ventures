# Deployment used by `npx convex dev`
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Convex environment variables (set with `npx convex env set NAME value`)
# ----------------------------------------------------------------------
# SITE_URL=http://localhost:3000
# 
# Email Configuration (Resend)
# RESEND_API_KEY=re_your_api_key_here
# EMAIL_FROM="MB Ventures GH <orders@yourdomain.com>"
# EMAIL_REPLY_TO=support@yourdomain.com  # Optional
# ADMIN_ALERT_EMAIL=admin@yourdomain.com
# EMAIL_DAILY_LIMIT=100  # Optional, defaults to 100
# EMAIL_DRY_RUN_LOG_CODES=true  # Only for development - logs auth codes to console
# RESEND_WEBHOOK_SECRET=whsec_your_webhook_secret  # Optional - for delivery tracking
#
# Payment (not yet implemented)
# PAYSTACK_SECRET_KEY=paystack_secret_key_here
# 
# Authentication
# AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
# AUTH_GOOGLE_SECRET=your-google-client-secret
# JWT_PRIVATE_KEY=your-jwt-private-key
# JWKS=your-jwks-json
# 
# Seed data (development only)
# ALLOW_SEED=true
